# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# COMPANY_DATA_API_KEY & URL: For Receita Federal / CNPJ lookup services (e.g. MinhaReceita, BrasilAPI, CNPJ.ws)
COMPANY_DATA_API_KEY=""
COMPANY_DATA_API_URL="https://minhareceita.org"

# TRANSCRIPTION_API_KEY: Optional dedicated transcription API key if used
TRANSCRIPTION_API_KEY=""

# DATABASE_URL: Database connection string (PostgreSQL/Managed DB)
DATABASE_URL=""

